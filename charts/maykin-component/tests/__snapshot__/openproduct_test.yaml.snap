matches the expected manifest for Open Product:
  1: |
    apiVersion: v1
    data:
      ALLOWED_HOSTS: RELEASE-NAME-openproduct,RELEASE-NAME-openproduct.NAMESPACE,openproduct-dev.test.opengem.nl
      CACHE_AXES: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CACHE_DEFAULT: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CACHE_OIDC: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CELERY_BROKER_URL: redis://RELEASE-NAME-redis-master.NAMESPACE:6379/1
      CELERY_LOGLEVEL: DEBUG
      CELERY_RESULT_BACKEND: redis://RELEASE-NAME-redis-master.NAMESPACE:6379/1
      DB_HOST: openproduct-db-host
      DB_NAME: openproduct
      DB_POOL_ENABLED: "False"
      DB_PORT: "5432"
      DB_USER: openproduct
      DEBUG: "False"
      DEFAULT_FROM_EMAIL: no-reply-on@opengem.nl
      DISABLE_2FA: "False"
      DJANGO_SETTINGS_MODULE: openproduct.conf.docker
      ELASTIC_APM_SERVICE_NAME: openproduct-maykin-test-aks
      EMAIL_HOST: smtp.sendgrid.net
      EMAIL_HOST_USER: apikey
      EMAIL_PORT: "587"
      EMAIL_USE_TLS: "True"
      ENVIRONMENT: openproduct-maykin-test-aks
      IS_HTTPS: "True"
      JSONSCHEMA_USE_FORMAT_CHECKER: "True"
      LOAD_UPL: "True"
      LOG_LEVEL: INFO
      LOG_NOTIFICATIONS_IN_DB: "True"
      LOG_OUTGOING_REQUESTS: "False"
      LOG_OUTGOING_REQUESTS_DB_SAVE: "False"
      LOG_OUTGOING_REQUESTS_DB_SAVE_BODY: "False"
      LOG_OUTGOING_REQUESTS_MAX_AGE: "7"
      LOG_OUTGOING_REQUESTS_RESET_DB_SAVE_AFTER: "60"
      LOG_REQUESTS: "True"
      NOTIFICATIONS_DISABLED: "True"
      OPENPRODUCT_SUPERUSER_EMAIL: ""
      OPENPRODUCT_SUPERUSER_USERNAME: ""
      OTEL_SDK_DISABLED: "True"
      PGSSLMODE: prefer
      RUN_SETUP_CONFIG: "True"
      USE_X_FORWARDED_HOST: "False"
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openproduct
        helm.sh/chart: maykin-component-0.1.0
      name: RELEASE-NAME-openproduct
      namespace: NAMESPACE
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openproduct
        helm.sh/chart: maykin-component-0.1.0
      name: RELEASE-NAME-openproduct
      namespace: NAMESPACE
    spec:
      replicas: 1
      selector:
        matchLabels:
          app.kubernetes.io/name: openproduct
      template:
        metadata:
          annotations: null
          labels:
            app.kubernetes.io/name: openproduct
        spec:
          containers:
            - env: null
              envFrom:
                - secretRef:
                    name: openproduct
                - configMapRef:
                    name: RELEASE-NAME-openproduct
              image: maykinmedia/open-product:1.10.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 6
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openproduct
                  path: /admin/
                  port: http
                initialDelaySeconds: 60
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              name: openproduct
              ports:
                - containerPort: 8000
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 6
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openproduct
                  path: /admin/
                  port: http
                initialDelaySeconds: 30
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              resources:
                limits:
                  cpu: 500m
                  memory: 1Gi
                requests:
                  cpu: 250m
                  memory: 512Mi
              securityContext:
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: false
                runAsNonRoot: true
                runAsUser: 1000
              startupProbe:
                failureThreshold: 30
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openproduct
                  path: /admin/
                  port: http
                initialDelaySeconds: 15
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              volumeMounts:
                - mountPath: /app/media
                  name: media
                  subPath: openproduct/media
                - mountPath: /app/private_media
                  name: media
                  subPath: openproduct/private_media
          enableServiceLinks: false
          securityContext:
            fsGroup: 1000
          serviceAccountName: RELEASE-NAME-openproduct
          volumes:
            - name: media
              persistentVolumeClaim:
                claimName: RELEASE-NAME-openproduct
