              resources: {}
              securityContext:
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: false
                runAsNonRoot: true
                runAsUser: 1000
              volumeMounts:
                - mountPath: /app/media
                  name: media
                  subPath: openorganisatie/media
          securityContext:
            fsGroup: 1000
          serviceAccountName: RELEASE-NAME-openorganisatie
          volumes:
            - name: media
