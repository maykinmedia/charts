matches the expected manifest for Open Organisatie:
  1: |
    apiVersion: v1
    data:
      ALLOWED_HOSTS: RELEASE-NAME-openorganisatie,RELEASE-NAME-openorganisatie.NAMESPACE,openorganisatie-dev.test.opengem.nl
      CACHE_AXES: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CACHE_DEFAULT: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CACHE_OIDC: RELEASE-NAME-redis-master.NAMESPACE:6379/0
      CELERY_BROKER_URL: redis://RELEASE-NAME-redis-master.NAMESPACE:6379/1
      CELERY_LOGLEVEL: DEBUG
      CELERY_RESULT_BACKEND: redis://RELEASE-NAME-redis-master.NAMESPACE:6379/1
      DB_HOST: openorganisatie-db-host
      DB_NAME: openorganisatie
      DB_PORT: "5432"
      DB_USER: openorganisatie
      DEFAULT_FROM_EMAIL: no-reply-on@opengem.nl
      DJANGO_SETTINGS_MODULE: openorganisatie.conf.docker
      ELASTIC_APM_SERVICE_NAME: openorganisatie-maykin-test-aks
      EMAIL_HOST: smtp.sendgrid.net
      EMAIL_HOST_USER: apikey
      EMAIL_PORT: "587"
      EMAIL_USE_TLS: "True"
      ENVIRONMENT: openorganisatie-maykin-test-aks
      IS_HTTPS: "True"
      NOTIFICATIONS_DISABLED: "True"
      OTEL_SDK_DISABLED: "True"
      PGSSLMODE: prefer
    kind: ConfigMap
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openorganisatie
        helm.sh/chart: maykin-component-0.1.0
      name: RELEASE-NAME-openorganisatie
      namespace: NAMESPACE
  2: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: openorganisatie
        helm.sh/chart: maykin-component-0.1.0
      name: RELEASE-NAME-openorganisatie
      namespace: NAMESPACE
    spec:
      replicas: 2
      selector:
        matchLabels:
          app.kubernetes.io/name: openorganisatie
      template:
        metadata:
          annotations: null
          labels:
            app.kubernetes.io/name: openorganisatie
        spec:
          containers:
            - env: null
              envFrom:
                - secretRef:
                    name: openorganisatie
                - configMapRef:
                    name: RELEASE-NAME-openorganisatie
              image: maykinmedia/open-organisatie:0.2.0
              imagePullPolicy: Always
              livenessProbe:
                failureThreshold: 6
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openorganisatie
                  path: /admin/
                  port: http
                initialDelaySeconds: 60
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              name: openorganisatie
              ports:
                - containerPort: 8000
                  name: http
                  protocol: TCP
              readinessProbe:
                failureThreshold: 6
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openorganisatie
                  path: /admin/
                  port: http
                initialDelaySeconds: 30
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              securityContext:
                capabilities:
                  drop:
                    - ALL
                readOnlyRootFilesystem: false
                runAsNonRoot: true
                runAsUser: 1000
              startupProbe:
                failureThreshold: 30
                httpGet:
                  httpHeaders:
                    - name: Host
                      value: RELEASE-NAME-openorganisatie
                  path: /admin/
                  port: http
                initialDelaySeconds: 15
                periodSeconds: 10
                successThreshold: 1
                timeoutSeconds: 10
              volumeMounts:
                - mountPath: /app/media
                  name: media
                  subPath: openorganisatie/media
                - mountPath: /app/private_media
                  name: media
                  subPath: openorganisatie/private_media
          enableServiceLinks: false
          securityContext:
            fsGroup: 1000
          serviceAccountName: RELEASE-NAME-openorganisatie
          volumes:
            - name: media
              persistentVolumeClaim:
                claimName: RELEASE-NAME-openorganisatie
  3: |
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      labels:
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/name: openorganisatie-worker
